# ============================================================
# 本仓库后续计划开源：以下内容「严禁入库」
# 提交前请用 git status 复核，务必确认没有凭据被跟踪
# ============================================================

# ── 【本项目专用·最高优先级】隐私信息统一存放目录 ──
#     密钥 / 密码 / 令牌 / 凭据 / 账号清单一律放 private/ 下，
#     该目录整体被忽略，任何情况下都不得提交；详见项目记忆
/private/

# ── 【本项目专用·最高优先级】文档目录不入远程仓库 ──
#     docs/ 内含生产域名、备案号、服务器目录结构等「运营身份信息」，
#     而本仓库是公开仓库，故整体排除，文档只保留在本地。
#     面向公众的说明请写在根目录 README.md（勿含运营细节）。
/docs/

# ── 密钥 / 凭据类文件 ──
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
*.ppk
*.token
id_rsa*
id_ed25519*
authorized_keys
known_hosts
config.local.php
config.secret.php

# ── 已知的本机敏感清单（含密钥列表，按文件名模式拦截）──
nvidia-keys-*
*keys-alive*
*secret*
*credential*

# ── 运行时数据 / 数据库 / 日志 ──
storage/
logs/
*.log
*.db
*.db-journal
*.sqlite
*.sqlite3

# ── PHP 依赖与构建产物 ──
/vendor/
# Webman 运行时（日志 / 缓存 / 进程文件），必须忽略
/runtime/
node_modules/
/tests/tmp/
/tests/.phpunit.result.cache
/dist/
/build/
*.cache

# ── 编辑器 / 操作系统 ──
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ── 备份 / 临时文件 ──
*.bak
*.tmp
*.old
*.orig
*.log.*
