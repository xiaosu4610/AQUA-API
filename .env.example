# ============================================================
# aqua-api-php 环境配置样例
#
# 用法：复制本文件为 .env 后按需修改
#     cp .env.example .env
#
# 安全要求（重要）：
#   · .env 已被 .gitignore 忽略，**永远不要提交到版本库**
#   · 本文件（.env.example）是唯一允许入库的配置文件，
#     因此这里**只能写占位符，绝不能写任何真实密钥**
# ============================================================

# ── 应用 ────────────────────────────────────────────────

# 调试开关。生产环境必须是 false：
# 为 true 时会把异常细节回给客户端，等于对外泄露内部结构
APP_DEBUG=true

# 时区。影响日志时间戳与所有日期计算
APP_TIMEZONE=Asia/Shanghai

# 应用密钥（建议 32 字节以上随机串）
# 用途：加密存储上游 API Key、签发管理后台会话
# 生成方式：php -r "echo bin2hex(random_bytes(32));"
# 注意：此项一旦设定并已加密过数据，就不要随意更换，否则旧数据无法解密
APP_KEY=

# 管理后台的初始管理员密码。
#
# 本项目后台是「超级管理员后台」：**登录只要密码，不需要用户名**。
#
# 三个要点：
#   1. 这里**只在首次初始化时用一次** —— 服务启动时发现还没有管理员，
#      就用这个值创建；之后改这里**不会**覆盖已存在的密码。
#   2. 后续改密码请走后台内的「修改密码」功能。
#   3. 本项目开源，**绝对不要把真实密码写进代码或提交到仓库**。
#      所以这里留空、且不提供任何默认值 —— 没配置就没法登录后台，
#      这是刻意的，避免出现「人人皆知的默认密码」。
ADMIN_PASSWORD=

# 会话 Cookie 是否只允许 HTTPS 传输。
# 默认（不设置）为 true，即生产环境的正确值。
# ⚠️ 本地用 http://127.0.0.1:8787 开发时，必须显式设为 false，
#    否则浏览器不会保存会话 Cookie，表现为「登录成功却立刻跳回登录页」。
#SESSION_SECURE=false

# 站点模式
#   commercial     商业站：显示定价、充值、订阅等入口
#   public_welfare 公益站：隐藏计费入口，转为「赞助」入口，并默认收紧限流
SITE_MODE=commercial

# ── HTTP 服务 ───────────────────────────────────────────

# 监听地址。
# 生产环境建议只监听 127.0.0.1，由 Nginx 反向代理对外提供 TLS 与域名，
# 这样 PHP 进程就不直接暴露在公网。
HTTP_LISTEN=http://127.0.0.1:8787

# 工作进程数。Linux 下按 CPU 核数配置。
# 注意：Windows 下该值无效（Workerman 在 Windows 上强制单进程）
HTTP_WORKER_COUNT=4

# ── 数据库 ──────────────────────────────────────────────

# 默认使用 SQLite：**留空即可，无需任何额外配置**，数据库文件放在 runtime/ 下。
# 需要换成 MySQL 时填写 PDO DSN，例如：
#   mysql:host=127.0.0.1;port=3306;dbname=aqua;charset=utf8mb4
DB_DSN=
DB_USER=
DB_PASSWORD=

# ── 缓存 / 跨进程状态 ───────────────────────────────────

# 留空则降级为「进程内缓存 + 文件锁」，仅适用于单机单进程。
# 多机部署或高并发场景必须配置 Redis，例如：redis://127.0.0.1:6379
REDIS_DSN=

# ── 运行期配置（可选）────────────────────────────────────
#
# 站点、网关、密钥池、安全、会话这几类可调项**不需要写在这里** ——
# 登录后台 →「配置管理」即可修改，改完几秒内全进程生效。
# 完整清单见 config/settings.php（代码默认值）。
#
# 如果需要用环境变量覆盖（例如容器化部署、配置即代码），
# 规则是「配置键的点号与减号换成下划线并大写」：
#     gateway.total_timeout      → GATEWAY_TOTAL_TIMEOUT
#     key_pool.default_rpm       → KEY_POOL_DEFAULT_RPM
#     security.login_max_attempts→ SECURITY_LOGIN_MAX_ATTEMPTS
#     site.name                  → SITE_NAME
#
# ⚠️ 优先级：数据库 > 环境变量 > 代码默认值。
#    也就是说，只要在后台改过某一项，它就被写进数据库，
#    此后改这里的同名环境变量**不再生效**。
#    想改回用环境变量，请在「配置管理」里对该项点「恢复默认」。
#
# ⚠️ 上游 API Key 绝不要写在这个文件里。
#    请通过管理后台的「渠道管理」添加，Key 会以 APP_KEY 加密后入库。
